# Copy to .env and fill in. Never commit .env.
# Every key below is optional for local development: without them the app runs in clearly labelled demo mode.

PORT=3000
# Public URL used in emails and payment callbacks (no trailing slash)
APP_URL=http://localhost:3000
# Set to "production" when you deploy. Turns off the dev email outbox and demo checkout
# unless DEMO_MODE=true (use that for a hosted demo; never with real customers).
NODE_ENV=development
DEMO_MODE=
# SQLite file location
DATABASE_PATH=./data/tinkerpath.db

# --- Payments (Paystack) ---------------------------------------------
# From Paystack dashboard > Settings > API Keys & Webhooks. Use sk_test_ first.
PAYSTACK_SECRET_KEY=
# Optional: plan codes (PLN_xxx) for monthly auto-renewing subscriptions.
# If empty, monthly plans are charged as one-month payments with renewal reminders.
PAYSTACK_PLAN_SELFPACED=
PAYSTACK_PLAN_GUIDED=

# --- Email -------------------------------------------------------------
# Resend (https://resend.com) API key. Without it, emails go to the dev outbox at /dev/outbox.
RESEND_API_KEY=
EMAIL_FROM=TinkerPath <hello@example.com>
SUPPORT_EMAIL=hello@example.com

# --- Live AI sandbox (optional) -----------------------------------------
# Anthropic API key. Without it the AI lab runs in offline practice mode.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Max live AI requests per child per day
AI_DAILY_LIMIT=20
